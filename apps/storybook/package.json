{
  "name": "@davinci-ai/storybook",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "storybook dev -p 6006",
    "build": "storybook build -o storybook-static",
    "test": "test-storybook --url http://127.0.0.1:6008 --maxWorkers=4",
    "typecheck": "tsc --noEmit",
    "test:light": "SB_THEME=light test-storybook --url http://127.0.0.1:6008 --maxWorkers=4",
    "serve": "http-server storybook-static -p 6008 -s -c-1 --silent",
    "test:ci": "start-server-and-test serve http://127.0.0.1:6008 test"
  },
  "dependencies": {
    "@davinci-ai/react": "workspace:*",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "@davinci-ai/examples": "workspace:*",
    "@fontsource-variable/inter": "^5.3.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^9.1.20",
    "@storybook/addon-docs": "^9.1.20",
    "@storybook/react-vite": "^9.1.20",
    "@storybook/test-runner": "^0.23.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.2.0",
    "http-server": "^14.1.1",
    "storybook": "^9.1.20",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vite": "^7.3.6",
    "axe-playwright": "^2.1.0",
    "playwright": "^1.63.0",
    "start-server-and-test": "^2.0.12"
  }
}